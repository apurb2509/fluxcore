generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model EmailLog {
  id              String   @id @default(uuid())
  emailFrom       String   
  subject         String
  body            String   @db.Text
  category        String
  urgency         String
  reason          String   @db.Text
  createdAt       DateTime @default(now())
  processedStatus Boolean  @default(false)
}